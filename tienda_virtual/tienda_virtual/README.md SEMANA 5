├── app.py                   # Punto de entrada (arranca el servidor con host/puerto del .env)
├── config/
│   └── database.py          # Clase Database -> patrón SINGLETON
├── models/
│   └── usuario_model.py     # MODELO: acceso a datos de usuarios
