│   ├── tema_correo.py       # TemaCorreoFactory + TemaEstandarFactory/TemaSeguridadFactory -> ABSTRACT FACTORY
│   ├── correo_builder.py    # CorreoBuilder -> patrón BUILDER (+ clonar() -> PROTOTYPE)
